<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compile-only check of every Unity script against minimal API stubs (no Unity install needed).
       Usage, from the repo root: dotnet build Tests/UnityCompileCheck -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>CS0067;CS0414;CS0169;CS0649</NoWarn>
    <DefineConstants>$(DefineConstants);UNITY_EDITOR</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/DuckAndCover/Scripts/**/*.cs" />
    <Compile Include="../../Assets/DuckAndCover/Editor/**/*.cs" />
  </ItemGroup>
</Project>
