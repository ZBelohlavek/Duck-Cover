# Output of Tools/unity capture
/Screenshots/

# Paid asset packs are kept as .unitypackage files in AssetPackages/ (Git LFS) and imported into
# Assets/ThirdParty/ on each machine. Never commit the imported files.
*.unitypackage
!/AssetPackages/**/*.unitypackage
/Assets/Synty/
/Assets/Synty.meta
/Assets/ThirdParty/
/Assets/ThirdParty.meta
